VisualsActivity {
    background-color: rgba(15, 15, 20, 0.85);
}

.title {
    left: 50%;
    top: 20%;
    alignment-x: center;
    font-size: 1.4;
    margin-bottom: 10;
}

.subtitle {
    left: 50%;
    alignment-x: center;
    margin-bottom: 20;
}

.container {
    left: 50%;
    top: 50%;
    width: 260;
    height: fit-content;
    alignment-x: center;
    alignment-y: center;
    space-between-entries: 8;
}

.button {
    width: 100%;
    height: 24;
    padding: 0 8 0 8;
}
